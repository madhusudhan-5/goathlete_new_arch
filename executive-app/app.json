{
  "expo": {
    "name": "GoAthlete Executive",
    "slug": "goathlete-executive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1F35"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.goathlete.executive",
      "buildNumber": "5",
      "icon": "./assets/logo.png",
      "backgroundColor": "#0A1F35",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "GoAthlete needs your location to find nearby venues and set venue locations.",
        "NSCameraUsageDescription": "GoAthlete needs camera access to take photos of your venue.",
        "NSPhotoLibraryUsageDescription": "GoAthlete needs photo library access to upload venue images."
      }
    },
    "android": {
      "package": "com.goathlete.executive",
      "versionCode": 5,
      "targetSdkVersion": 35,
      "compileSdkVersion": 35,
      "buildToolsVersion": "35.0.0",
      "icon": "./assets/logo.png",
      "backgroundColor": "#0A1F35",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#0A1F35"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ],
      "expo-image-picker",
      "expo-location",
      "expo-document-picker",
      "expo-file-system",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "25a4a8fa-c02e-4e2f-8344-55f9664fb9a2"
      }
    },
    "owner": "madlee.smp"
  }
}
