{
  "expo": {
    "name": "GoAthlete Executive",
    "slug": "goathlete-executive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1F35"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.goathlete.executive",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "GoAthlete needs your location to find nearby venues and set venue locations.",
        "NSCameraUsageDescription": "GoAthlete needs camera access to take photos of your venue.",
        "NSPhotoLibraryUsageDescription": "GoAthlete needs photo library access to upload venue images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A1F35"
      },
      "package": "com.goathlete.executive",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-image-picker",
      "expo-location",
      "expo-document-picker",
      "expo-file-system"
    ],
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
