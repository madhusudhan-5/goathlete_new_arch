{
  "expo": {
    "name": "GoAthlete",
    "slug": "goathlete-player",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "goathleteapp",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1F35"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.goathlete.player",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "GoAthlete needs camera access to update your profile photo.",
        "NSPhotoLibraryUsageDescription": "GoAthlete needs photo library access to choose a profile image.",
        "NSLocationWhenInUseUsageDescription": "GoAthlete uses your location to find nearby venues and tournaments."
      }
    },
    "android": {
      "package": "com.goathlete.player",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A1F35"
      },
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2faf3d16-ad70-4015-8086-1021fc08fc9d"
      }
    }
  }
}
